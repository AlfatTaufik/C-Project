{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build C File",
      "type": "shell",
      "command": "C:\\MinGW\\bin\\gcc.exe",
      "args": [
        "${file}",
        "-o",
        "${workspaceFolder}\\output\\${fileBasenameNoExtension}.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
